<?xml version="1.0" encoding="utf-8"?>
<!-- Backup is fully disabled (mirrors android:allowBackup="false"); these
     rules make that explicit for Android 12+ cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>